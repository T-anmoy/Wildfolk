{%- comment -%}
  The Filling Jar: progress towards free shipping from cart.total_price (after
  discounts, before shipping). Guidance only — Shopify evaluates the free-shipping
  rate at checkout; the threshold setting must match Settings → Shipping.
  Hidden when the threshold is blank or the cart is empty.
{%- endcomment -%}
{%- if settings.wf_free_shipping_threshold != blank and settings.wf_free_shipping_threshold > 0 and cart.item_count > 0 -%}
  {%- liquid
    assign threshold = settings.wf_free_shipping_threshold | times: 100
    assign remaining = threshold | minus: cart.total_price
    assign permille = cart.total_price | times: 1000 | divided_by: threshold
    if permille > 1000
      assign permille = 1000
    endif
    assign fill = permille | divided_by: 1000.0
    assign clip_id = 'WfJarClip-' | append: context
  -%}
  <wf-free-ship class="wf-free-ship{% if remaining <= 0 %} is-complete{% endif %}" data-fill="{{ fill }}" style="--wf-fill: {{ fill }};">
    <svg class="wf-free-ship__jar" viewBox="0 0 32 40" width="32" height="40" aria-hidden="true" focusable="false">
      <defs>
        <clipPath id="{{ clip_id }}">
          <path d="M10 4h12v4c3 1 5 3.5 5 7v18a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3V15c0-3.5 2-6 5-7z"/>
        </clipPath>
      </defs>
      <g clip-path="url(#{{ clip_id }})">
        <rect class="wf-free-ship__fill" x="0" y="0" width="32" height="40"/>
      </g>
      <path class="wf-free-ship__outline" d="M10 4h12v4c3 1 5 3.5 5 7v18a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3V15c0-3.5 2-6 5-7z"/>
      <path class="wf-free-ship__outline" d="M9 4h14"/>
    </svg>
    <p class="wf-free-ship__text">
      {%- if remaining > 0 -%}
        <strong>{{ remaining | money }}</strong> away from free shipping
      {%- else -%}
        Free shipping unlocked
      {%- endif -%}
    </p>
  </wf-free-ship>
{%- endif -%}
