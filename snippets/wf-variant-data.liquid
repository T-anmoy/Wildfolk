{%- comment -%}
  Per-variant facts for Wildfolk product UI:
  { variantId: { p: price (paise), w: net weight in g } }.

  Net weight resolution:
  1. variant metafield wildfolk.net_weight_g
  2. product metafield wildfolk.net_weight_g as fallback

  Consumed by wf-commerce.js for unit-price updates on Craft's
  variant-change event.
{%- endcomment -%}

{%- assign product_nw = product.metafields.wildfolk.net_weight_g.value | default: 0 | plus: 0 -%}

<script
  type="application/json"
  data-wf-variants="{{ section_id }}"
  data-money-format="{{ shop.money_format | escape }}"
>
  {
    {%- for variant in product.variants -%}
      {%- assign nw = variant.metafields.wildfolk.net_weight_g.value | default: 0 | plus: 0 -%}

      {%- if nw <= 0 -%}
        {%- assign nw = product_nw -%}
      {%- endif -%}

      "{{ variant.id }}": {
        "p": {{ variant.price }},
        "w": {{ nw }}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  }
</script>
