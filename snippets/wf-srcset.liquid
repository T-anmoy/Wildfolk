{% comment %}
  Outputs a srcset for one image: standard widths up to the source width,
  plus the source width itself when it is smaller than the largest standard width.
  Usage: srcset="{% render 'wf-srcset', img: image %}"
{% endcomment %}
{%- liquid
  assign widths = '375,550,750,1100,1500,2000,2600' | split: ','
  assign source_width = img.width | append: ''
  assign entries = ''
  for w in widths
    assign wn = w | plus: 0
    if wn <= img.width
      assign entry = img | image_url: width: wn | append: ' ' | append: w | append: 'w'
      assign entries = entries | append: entry | append: '|'
    endif
  endfor
  if img.width < 2600
    unless widths contains source_width
      assign entry = img | image_url: width: img.width | append: ' ' | append: source_width | append: 'w'
      assign entries = entries | append: entry
    endunless
  endif
  assign list = entries | split: '|'
  echo list | join: ', '
-%}
