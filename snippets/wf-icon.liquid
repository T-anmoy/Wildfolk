{%- comment -%} Small 1.5px line icons (20×20), decorative. name: truck | shield | lock | cash | leaf | clock {%- endcomment -%}
<svg class="wf-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
