    {%- when 'lock' -%}<rect x="5" y="11" width="14" height="9" rx="1"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>
    {%- when 'cash' -%}<rect x="3" y="7" width="18" height="10" rx="1"/><circle cx="12" cy="12" r="2.5"/>
    {%- when 'clock' -%}<circle cx="12" cy="12" r="8"/><path d="M12 8v4l3 2"/>
