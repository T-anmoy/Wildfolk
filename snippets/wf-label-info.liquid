{%- comment -%}
  Wildfolk label information for pre-packaged food.

  Final product metafields:
  - wildfolk.ingredients
  - wildfolk.mrp
  - wildfolk.best_before
  - wildfolk.storage
  - wildfolk.manufacturer_packer
  - wildfolk.fssai_licence
  - wildfolk.net_weight_g
  - wildfolk.safety_note

  Consumer-care details come from Theme settings → Wildfolk commerce.

  Country of origin is retained only as a legacy optional field if it
  already exists. Nothing is invented. Empty rows are hidden.
{%- endcomment -%}

{%- liquid
  assign mf = product.metafields.wildfolk

  assign ingredients = mf.ingredients.value
  assign best_before = mf.best_before.value
  assign storage = mf.storage.value
  assign manufacturer = mf.manufacturer_packer.value
  assign safety = mf.safety_note.value

  assign nw = mf.net_weight_g.value | default: 0 | plus: 0
  assign mrp = mf.mrp

  assign fssai = mf.fssai_licence.value
  if fssai == blank
    assign fssai = settings.wf_fssai_licence
  endif

  assign origin = mf.country_of_origin.value

  assign care_phone = settings.wf_seller_phone
  assign care_email = settings.wf_seller_email

  assign has_info = false

  if ingredients != blank or best_before != blank or storage != blank or manufacturer != blank or safety != blank or nw > 0 or mrp != blank or fssai != blank or origin != blank or care_phone != blank or care_email != blank
    assign has_info = true
  endif
-%}

{%- if has_info -%}
  <details class="wf-label-info" {{ block.shopify_attributes }}>
    <summary class="wf-label-info__summary">
      <span>Label information</span>
      <span class="wf-label-info__icon" aria-hidden="true"></span>
    </summary>

    <dl class="wf-label-info__list">

      {%- if ingredients != blank -%}
        <div class="wf-label-info__row">
          <dt>Ingredients</dt>
          <dd>{{ ingredients | escape }}</dd>
        </div>
      {%- endif -%}

      {%- if nw > 0 -%}
        <div class="wf-label-info__row">
          <dt>Net weight</dt>
          <dd>{{ nw }} g</dd>
        </div>
      {%- endif -%}

      {%- if mrp != blank -%}
        <div class="wf-label-info__row">
          <dt>MRP</dt>
          <dd>
            {{ mrp | metafield_text | escape }}
            {%- if settings.wf_prices_include_tax %}
              <span class="wf-label-info__tax"> (Inclusive of all taxes)</span>
            {%- endif -%}
          </dd>
        </div>
      {%- endif -%}

      {%- if best_before != blank -%}
        <div class="wf-label-info__row">
          <dt>Best before</dt>
          <dd>{{ best_before | escape }}</dd>
        </div>
      {%- endif -%}

      {%- if storage != blank -%}
        <div class="wf-label-info__row">
          <dt>Storage</dt>
          <dd>{{ storage | escape | newline_to_br }}</dd>
        </div>
      {%- endif -%}

      {%- if origin != blank -%}
        <div class="wf-label-info__row">
          <dt>Country of origin</dt>
          <dd>{{ origin | escape }}</dd>
        </div>
      {%- endif -%}

      {%- if manufacturer != blank -%}
        <div class="wf-label-info__row">
          <dt>Manufacturer / packer</dt>
          <dd>{{ manufacturer | escape | newline_to_br }}</dd>
        </div>
      {%- endif -%}

      {%- if fssai != blank -%}
        <div class="wf-label-info__row">
          <dt>FSSAI licence</dt>
          <dd>{{ fssai | escape }}</dd>
        </div>
      {%- endif -%}

      {%- if care_phone != blank or care_email != blank -%}
        <div class="wf-label-info__row">
          <dt>Consumer care</dt>
          <dd>
            {%- if care_phone != blank -%}
              <a href="tel:{{ care_phone | remove: ' ' | escape }}">
                {{- care_phone | escape -}}
              </a>
            {%- endif -%}

            {%- if care_phone != blank and care_email != blank %}
              ·
            {% endif -%}

            {%- if care_email != blank -%}
              <a href="mailto:{{ care_email | escape }}">
                {{- care_email | escape -}}
              </a>
            {%- endif -%}
          </dd>
        </div>
      {%- endif -%}

      {%- if safety != blank -%}
        <div class="wf-label-info__row">
          <dt>Safety note</dt>
          <dd>{{ safety | escape | newline_to_br }}</dd>
        </div>
      {%- endif -%}

    </dl>
  </details>

{%- elsif request.design_mode -%}
  <p class="wf-editor-notice" {{ block.shopify_attributes }}>
    Label information is hidden until confirmed product labelling data or consumer-care details are provided. Empty rows are hidden automatically. (Only visible in the theme editor.)
  </p>
{%- endif -%}
