{% comment %}
  Responsive image helper with optional mobile art direction and focal points.
  Usage:
    {% render 'wf-media',
       image: section.settings.image,
       image_mobile: section.settings.image_mobile,
       alt: section.settings.image.alt,
       decorative: false,
       sizes_attr: '(min-width: 990px) 50vw, 100vw',
       sizes_mobile: '100vw',
       loading: 'lazy',
       fetchpriority: 'auto',
       class: 'wf-media--cover'
    %}
  - The merchant-set focal point (Admin → Files / image editor) is applied as
    object-position through --wf-focal / --wf-focal-mobile.
  - decorative: true renders alt="" (use inside links that already carry the title).
  - With no image, a quiet aria-hidden placeholder keeps the layout stable.
  Never used for the hero/LCP image without loading:'eager' and
  fetchpriority:'high' passed explicitly by the calling section.
{% endcomment %}
{%- liquid
  assign img = image
  assign img_mobile = image_mobile
  assign alt_text = alt | default: img.alt | escape
  if decorative
    assign alt_text = ''
  endif
  assign sizes_attr = sizes_attr | default: '100vw'
  assign sizes_mobile = sizes_mobile | default: '100vw'
  assign loading_attr = loading | default: 'lazy'
  assign fetchpriority_attr = fetchpriority | default: 'auto'
  assign focal = img.presentation.focal_point | default: '50% 50%'
  assign focal_mobile = img_mobile.presentation.focal_point | default: focal
  assign src_width = img.width | at_most: 1500
-%}
{%- if img == blank -%}
  <div class="wf-media wf-media--placeholder {{ class }}" aria-hidden="true"></div>
{%- else -%}
  <picture
    class="wf-media{% if img_mobile != blank %} wf-media--art-directed{% endif %} {{ class }}"
    style="--wf-focal: {{ focal }}; --wf-focal-mobile: {{ focal_mobile }};"
  >
    {%- if img_mobile != blank -%}
      <source
        media="(max-width: 749px)"
        srcset="{% render 'wf-srcset', img: img_mobile %}"
        sizes="{{ sizes_mobile }}"
        width="{{ img_mobile.width }}"
        height="{{ img_mobile.height }}"
      >
    {%- endif -%}
    <img
      src="{{ img | image_url: width: src_width }}"
      srcset="{% render 'wf-srcset', img: img %}"
      sizes="{{ sizes_attr }}"
      alt="{{ alt_text }}"
      width="{{ img.width }}"
      height="{{ img.height }}"
      loading="{{ loading_attr }}"
      {% if fetchpriority_attr != 'auto' %}fetchpriority="{{ fetchpriority_attr }}"{% endif %}
      {% if loading_attr == 'lazy' %}decoding="async"{% endif %}
      class="wf-media__img"
    >
  </picture>
{%- endif -%}
