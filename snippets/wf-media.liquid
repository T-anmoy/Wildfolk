{% comment %}
  Responsive image helper with optional mobile art direction.
  Usage:
    {% render 'wf-media',
       image: section.settings.image,
       image_mobile: section.settings.image_mobile,
       alt: section.settings.image.alt,
       sizes_attr: '100vw',
       loading: 'lazy',
       fetchpriority: 'auto',
       class: 'wf-media__img'
    %}
  Never used for the hero/LCP image without loading:'eager' and
  fetchpriority:'high' passed explicitly by the calling section.
{% endcomment %}
{%- liquid
  assign img = image
  assign img_mobile = image_mobile
  assign alt_text = alt | default: img.alt | escape
  assign sizes_attr = sizes_attr | default: '100vw'
  assign loading_attr = loading | default: 'lazy'
  assign fetchpriority_attr = fetchpriority | default: 'auto'
  assign widths = '375, 550, 750, 1100, 1500, 2000, 2600'
-%}
{%- if img == blank -%}
  <div class="wf-media wf-media--placeholder {{ class }}" role="img" aria-label="{{ alt_text | default: 'Image coming soon' }}"></div>
{%- else -%}
  <picture class="wf-media {{ class }}">
    {%- if img_mobile != blank -%}
      <source media="(max-width: 749px)" srcset="{{ img_mobile | image_url: width: 375 }} 375w, {{ img_mobile | image_url: width: 750 }} 750w, {{ img_mobile | image_url: width: 1080 }} 1080w" sizes="100vw">
    {%- endif -%}
    <img
      src="{{ img | image_url: width: 1500 }}"
      srcset="{%- for w in widths -%}{{ img | image_url: width: w }} {{ w }}w{% unless forloop.last %}, {% endunless %}{%- endfor -%}"
      sizes="{{ sizes_attr }}"
      alt="{{ alt_text }}"
      width="{{ img.width }}"
      height="{{ img.height }}"
      loading="{{ loading_attr }}"
      {% if fetchpriority_attr != 'auto' %}fetchpriority="{{ fetchpriority_attr }}"{% endif %}
      class="wf-media__img"
    >
  </picture>
{%- endif -%}
