{{ 'wf-home.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign blog = section.settings.blog
  assign articles = blog.articles
  assign featured = articles.first
  assign secondary = articles | slice: 1, 3
-%}

<div class="wf-section color-{{ section.settings.color_scheme }} gradient">
  <div class="wf-content">
    <div class="wf-journal__header" data-wf-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <p class="wf-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="wf-heading wf-heading--xl">
        {{ section.settings.heading }}
      </h2>
    </div>

    {%- if featured != blank -%}
      <div class="wf-journal__layout">
        <a href="{{ featured.url }}" class="wf-journal__featured" data-wf-reveal>
          <div class="wf-journal__featured-media">
            {%- render 'wf-media', image: featured.image, alt: featured.title, sizes_attr: '(min-width: 990px) 55vw, 100vw' -%}
          </div>
          <p class="wf-eyebrow" style="margin-top: var(--wf-space-xs);">{{ featured.published_at | time_tag: format: 'month_day_year' }}</p>
          <h3 class="wf-heading wf-heading--lg">{{ featured.title }}</h3>
          <p class="wf-body">{{ featured.excerpt_or_content | strip_html | truncatewords: 28 }}</p>
        </a>

        <div class="wf-journal__secondary">
          {%- for article in secondary -%}
            <a href="{{ article.url }}" class="wf-journal__secondary-item" data-wf-reveal>
              <div class="wf-journal__secondary-media">
                {%- render 'wf-media', image: article.image, alt: article.title, sizes_attr: '8rem' -%}
              </div>
              <span>
                <span class="wf-eyebrow" style="display:block;">{{ article.published_at | time_tag: format: 'month_day_year' }}</span>
                <span class="wf-heading" style="font-size: 1.9rem; display:block;">{{ article.title }}</span>
              </span>
            </a>
          {%- endfor -%}
        </div>
      </div>

      {%- if section.settings.show_view_all -%}
        <p style="margin-top: var(--wf-space-md);" data-wf-reveal>
          <a href="{{ blog.url }}" class="button button--secondary">
            {{ 'sections.wf_journal.view_all' | t }}
          </a>
        </p>
      {%- endif -%}
    {%- else -%}
      <p class="wf-body" data-wf-reveal>{{ 'sections.wf_journal.no_articles' | t }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Wildfolk journal feature",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Journal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stories from the hive"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show \"view all\" link",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Wildfolk journal feature"
    }
  ]
}
{% endschema %}
