{{ 'wf-home.css' | asset_url | stylesheet_tag }}

<div
  class="wf-section wf-final-cta wf-scene color-{{ section.settings.color_scheme }} gradient"
  data-wf-scene="final"
  data-wf-bee-x="50"
  data-wf-bee-y="45"
>
  <div class="wf-content wf-final-cta__body">
    {%- if section.settings.eyebrow != blank -%}
      <p class="wf-eyebrow" data-wf-reveal>{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="wf-heading wf-heading--xl" data-wf-reveal>{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="wf-body rte" data-wf-reveal>{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <div data-wf-reveal>
        <a
          {% if section.settings.button_link == blank %}role="link" aria-disabled="true"{% else %}href="{{ section.settings.button_link }}"{% endif %}
          class="button button--primary"
        >
          {{ section.settings.button_label | escape }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Wildfolk final CTA",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Journey Ends Here"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "[CLOSING HEADLINE — client copy]"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Body text",
      "default": ""
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Honey"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-5"
    }
  ],
  "presets": [
    {
      "name": "Wildfolk final CTA"
    }
  ]
}
{% endschema %}
