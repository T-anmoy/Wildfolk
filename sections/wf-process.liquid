<div
  class="wf-section wf-process wf-scene color-{{ section.settings.color_scheme }} gradient"
  data-wf-scene="process"
  data-wf-bee-x="30"
  data-wf-bee-y="12"
>
  <div class="wf-grid">
    <div class="wf-process__header wf-measure">
      {%- if section.settings.eyebrow != blank -%}
        <p class="wf-eyebrow" data-wf-reveal>{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="wf-heading wf-heading--xl" data-wf-reveal>{{ section.settings.heading }}</h2>
      {%- else -%}
        <h2 class="wf-heading wf-heading--xl" data-wf-reveal>{{ 'sections.wf_process.heading' | t }}</h2>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="wf-process__track">
        {%- comment -%} One hairline thread joins the steps; it draws once when revealed. {%- endcomment -%}
        <span class="wf-process__thread" data-wf-reveal aria-hidden="true"></span>
        <ol class="wf-process__steps" style="--wf-steps: {{ section.blocks.size }};">
          {%- for block in section.blocks -%}
            <li class="wf-process__step" data-wf-reveal {{ block.shopify_attributes }}>
              <span class="wf-process__step-index" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              {%- if block.settings.image != blank -%}
                <div class="wf-process__step-media wf-frame">
                  {%- render 'wf-media',
                    image: block.settings.image,
                    alt: block.settings.title,
                    sizes_attr: '(min-width: 1200px) 260px, (min-width: 600px) 45vw, 100vw'
                  -%}
                </div>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <h3 class="wf-heading wf-process__title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="wf-body rte wf-process__text">{% render 'wf-rte', html: block.settings.text %}</div>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ol>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Wildfolk process",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "From Hive to Bottle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Optional. Landscape (4:3)."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "[STEP NAME]"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Description",
          "default": "<p>[STEP DESCRIPTION — client-confirmed process detail]</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Wildfolk process",
      "blocks": [
        { "type": "step", "settings": { "title": "Harvest" } },
        { "type": "step", "settings": { "title": "Process" } },
        { "type": "step", "settings": { "title": "Bottle" } },
        { "type": "step", "settings": { "title": "Table" } }
      ]
    }
  ]
}
{% endschema %}
