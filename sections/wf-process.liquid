{{ 'wf-home.css' | asset_url | stylesheet_tag }}

<div
  class="wf-section wf-scene color-{{ section.settings.color_scheme }} gradient"
  data-wf-scene="process"
  data-wf-bee-x="30"
  data-wf-bee-y="12"
>
  <div class="wf-content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="wf-eyebrow" data-wf-reveal>{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="wf-heading wf-heading--xl" data-wf-reveal>{{ section.settings.heading }}</h2>
    {%- else -%}
      <h2 class="wf-heading wf-heading--xl" data-wf-reveal>{{ 'sections.wf_process.heading' | t }}</h2>
    {%- endif -%}

    <ol class="wf-process__steps">
      {%- for block in section.blocks -%}
        <li class="wf-process__step" data-wf-reveal {{ block.shopify_attributes }}>
          <span class="wf-process__step-index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          {%- if block.settings.image != blank -%}
            <div class="wf-process__step-media">
              {%- render 'wf-media', image: block.settings.image, alt: block.settings.title, sizes_attr: '(min-width: 750px) 30vw, 90vw' -%}
            </div>
          {%- endif -%}
          <h3 class="wf-heading wf-heading--lg" style="font-size: 2rem;">{{ block.settings.title | escape }}</h3>
          {%- if block.settings.text != blank -%}
            <p class="wf-body" style="font-size: 1.5rem;">{{ block.settings.text }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</div>

{% schema %}
{
  "name": "Wildfolk process",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "From Hive to Bottle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": ""
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "[STEP NAME]"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Description",
          "default": "<p>[STEP DESCRIPTION — client-confirmed process detail]</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Wildfolk process",
      "blocks": [
        { "type": "step", "settings": { "title": "Harvest" } },
        { "type": "step", "settings": { "title": "Process" } },
        { "type": "step", "settings": { "title": "Bottle" } },
        { "type": "step", "settings": { "title": "Table" } }
      ]
    }
  ]
}
{% endschema %}
