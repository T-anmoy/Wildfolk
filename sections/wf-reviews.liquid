{{ 'wf-home.css' | asset_url | stylesheet_tag }}

<div class="wf-section color-{{ section.settings.color_scheme }} gradient">
  <div class="wf-content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="wf-eyebrow" data-wf-reveal>{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="wf-heading wf-heading--xl" data-wf-reveal>{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="wf-process__steps" style="margin-top: var(--wf-space-lg);">
        {%- for block in section.blocks -%}
          <blockquote class="wf-process__step" data-wf-reveal {{ block.shopify_attributes }}>
            <p class="wf-body" style="font-family: var(--font-heading-family); font-size: var(--wf-size-h3); line-height: 1.2;">
              &ldquo;{{ block.settings.quote | escape }}&rdquo;
            </p>
            <footer class="wf-eyebrow" style="margin-top: var(--wf-space-xs);">
              {{ block.settings.author | escape }}{% if block.settings.location != blank %}, {{ block.settings.location | escape }}{% endif %}
            </footer>
          </blockquote>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="wf-body" data-wf-reveal style="margin-top: var(--wf-space-sm); opacity: 0.7;">
        {{ 'sections.wf_reviews.empty' | t }}
      </p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Wildfolk reviews",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "What People Say"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real words from real tables"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "info": "Only add genuine, client-confirmed customer reviews here."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author name"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Author location (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Wildfolk reviews"
    }
  ]
}
{% endschema %}
