{%- liquid
  assign origin_alt = section.settings.image.alt | default: section.settings.origin_name
  assign show_media = false
  if section.settings.image != blank or request.design_mode
    assign show_media = true
  endif
-%}

<div
  class="wf-section wf-origin wf-scene{% unless show_media %} wf-origin--no-media{% endunless %} color-{{ section.settings.color_scheme }} gradient"
  data-wf-scene="origin"
  data-wf-bee-x="65"
  data-wf-bee-y="20"
>
  <div class="wf-grid">
    {%- if show_media -%}
      {%- comment -%} Landscape-led: the image runs on the wide track. Reveal on the frame, drift on an inner layer. {%- endcomment -%}
      <div class="wf-origin__media wf-frame wf-wide" data-wf-reveal>
        <div class="wf-drift-layer" data-wf-drift>
          {%- render 'wf-media',
            image: section.settings.image,
            image_mobile: section.settings.image_mobile,
            alt: origin_alt,
            sizes_attr: '(min-width: 1440px) 1440px, 100vw',
            sizes_mobile: '100vw'
          -%}
        </div>
      </div>
    {%- endif -%}

    <div class="wf-origin__copy">
      <div class="wf-origin__intro">
        {%- if section.settings.eyebrow != blank -%}
          <p class="wf-eyebrow" data-wf-reveal>{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="wf-heading wf-heading--xl" data-wf-reveal>{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
      {%- if section.settings.text != blank -%}
        <div class="wf-body rte wf-origin__text" data-wf-reveal>{% render 'wf-rte', html: section.settings.text %}</div>
      {%- endif -%}
    </div>

    {%- if section.settings.origin_name != blank or section.settings.location_label != blank -%}
      <dl class="wf-origin__meta" data-wf-reveal>
        {%- if section.settings.origin_name != blank -%}
          <div>
            <dt>{{ 'sections.wf_origin.origin' | t }}</dt>
            <dd>{% render 'wf-text', text: section.settings.origin_name %}</dd>
          </div>
        {%- endif -%}
        {%- if section.settings.location_label != blank -%}
          <div>
            <dt>{{ 'sections.wf_origin.location' | t }}</dt>
            <dd>{% render 'wf-text', text: section.settings.location_label %}</dd>
          </div>
        {%- endif -%}
      </dl>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Wildfolk origin",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Landscape image",
      "info": "Wide landscape (at least 2400px, roughly 21:9 safe area). Set a focal point to control the crop."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Optional portrait crop (4:5) for phones (below 750px). Falls back to the image above."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Origin"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "[ORIGIN HEADING — client copy]"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Body text",
      "default": "<p>[ORIGIN STORY — replace with confirmed client copy]</p>"
    },
    {
      "type": "text",
      "id": "origin_name",
      "label": "Origin name",
      "default": "[CLIENT ORIGIN]"
    },
    {
      "type": "text",
      "id": "location_label",
      "label": "Location label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    }
  ],
  "presets": [
    {
      "name": "Wildfolk origin"
    }
  ]
}
{% endschema %}
