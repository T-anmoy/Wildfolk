{{ 'wf-home.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign is_first_section = false
  if section.index == 1
    assign is_first_section = true
  endif
  assign loading_attr = 'lazy'
  assign fetchpriority_attr = 'auto'
  if is_first_section
    assign loading_attr = 'eager'
    assign fetchpriority_attr = 'high'
  endif
  assign hero_alt = section.settings.image.alt | default: section.settings.heading
-%}

<div
  class="wf-hero wf-scene color-{{ section.settings.color_scheme }} gradient"
  data-wf-scene="hero"
  data-wf-bee-x="78"
  data-wf-bee-y="30"
>
  <div class="wf-hero__media">
    {%- render 'wf-media',
      image: section.settings.image,
      image_mobile: section.settings.image_mobile,
      alt: hero_alt,
      sizes_attr: '100vw',
      loading: loading_attr,
      fetchpriority: fetchpriority_attr
    -%}
  </div>
  <div class="wf-hero__scrim" aria-hidden="true"></div>

  <div class="wf-hero__body">
    {%- if section.settings.eyebrow != blank -%}
      <p class="wf-eyebrow" data-wf-reveal>{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="wf-heading wf-heading--display" data-wf-reveal>
        {{ section.settings.heading }}
      </h1>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="wf-body rte" data-wf-reveal>
        {{ section.settings.text }}
      </div>
    {%- endif -%}

    <div class="wf-hero__actions" data-wf-reveal>
      {%- if section.settings.button_label != blank -%}
        <a
          {% if section.settings.button_link == blank %}role="link" aria-disabled="true"{% else %}href="{{ section.settings.button_link }}"{% endif %}
          class="button button--primary"
        >
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
      {%- if section.settings.button_label_secondary != blank -%}
        <a
          {% if section.settings.button_link_secondary == blank %}role="link" aria-disabled="true"{% else %}href="{{ section.settings.button_link_secondary }}"{% endif %}
          class="button button--secondary"
        >
          {{ section.settings.button_label_secondary | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Wildfolk hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Optional. Falls back to the desktop image below 750px."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Wildfolk Honey"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A living journey from hive to table."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Supporting text",
      "default": "<p>[PRODUCT DESCRIPTION — replace with confirmed client copy]</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button label",
      "default": "Shop Honey"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_label_secondary",
      "label": "Secondary button label",
      "default": "Our Story"
    },
    {
      "type": "url",
      "id": "button_link_secondary",
      "label": "Secondary button link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-4"
    }
  ],
  "presets": [
    {
      "name": "Wildfolk hero"
    }
  ]
}
{% endschema %}
