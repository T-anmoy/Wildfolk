{%- liquid
  assign has_image = false
  if section.settings.image != blank
    assign has_image = true
  endif
  # LCP: eager + high priority when "Prioritise image loading" is on, or when the hero is the first section.
  assign loading_attr = 'lazy'
  assign fetchpriority_attr = 'auto'
  if section.settings.priority_load or section.index == 1
    assign loading_attr = 'eager'
    assign fetchpriority_attr = 'high'
  endif
  assign hero_alt = section.settings.image.alt | default: section.settings.heading
-%}

<div
  class="wf-hero wf-scene color-{{ section.settings.color_scheme }} gradient{% if has_image %} wf-hero--has-image{% endif %}"
  data-wf-scene="hero"
  data-wf-bee-x="78"
  data-wf-bee-y="30"
>
  {%- if has_image -%}
    <div class="wf-hero__media">
      {%- render 'wf-media',
        image: section.settings.image,
        image_mobile: section.settings.image_mobile,
        alt: hero_alt,
        sizes_attr: '100vw',
        sizes_mobile: '100vw',
        loading: loading_attr,
        fetchpriority: fetchpriority_attr
      -%}
    </div>
    <div class="wf-hero__scrim" aria-hidden="true"></div>
  {%- endif -%}

  <div class="wf-hero__body wf-grid">
    <div class="wf-hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="wf-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="wf-heading wf-heading--display">
          {{ section.settings.heading }}
        </h1>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="wf-body rte">
          {{ section.settings.text }}
        </div>
      {%- endif -%}

      {%- capture primary_live -%}{%- render 'wf-link-live', url: section.settings.button_link -%}{%- endcapture -%}
      {%- capture secondary_live -%}{%- render 'wf-link-live', url: section.settings.button_link_secondary -%}{%- endcapture -%}
      {%- liquid
        assign show_primary = false
        if section.settings.button_label != blank and primary_live == 'true'
          assign show_primary = true
        endif
        assign show_secondary = false
        if section.settings.button_label_secondary != blank and secondary_live == 'true'
          assign show_secondary = true
        endif
      -%}
      {%- if show_primary or show_secondary -%}
        <div class="wf-hero__actions">
          {%- if show_primary -%}
            <a
              {% if section.settings.button_link == blank %}role="link" aria-disabled="true"{% else %}href="{{ section.settings.button_link }}"{% endif %}
              class="button button--primary"
            >
              {{ section.settings.button_label | escape }}
            </a>
          {%- endif -%}
          {%- if show_secondary -%}
            <a
              {% if section.settings.button_link_secondary == blank %}role="link" aria-disabled="true"{% else %}href="{{ section.settings.button_link_secondary }}"{% endif %}
              class="button button--secondary"
            >
              {{ section.settings.button_label_secondary | escape }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Wildfolk hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image",
      "info": "Landscape, at least 2600px wide. Set a focal point on the image to control the crop."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Optional portrait crop (4:5 or taller). Falls back to the desktop image below 750px."
    },
    {
      "type": "checkbox",
      "id": "priority_load",
      "label": "Prioritise image loading",
      "info": "Keep on when this hero is the first visible section.",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Wildfolk Honey"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A living journey from hive to table."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Supporting text",
      "default": "<p>[PRODUCT DESCRIPTION — replace with confirmed client copy]</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button label",
      "default": "Shop Honey"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_label_secondary",
      "label": "Secondary button label",
      "default": "Our Story"
    },
    {
      "type": "url",
      "id": "button_link_secondary",
      "label": "Secondary button link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "info": "Text colour and the image scrim both follow this scheme.",
      "default": "scheme-4"
    }
  ],
  "presets": [
    {
      "name": "Wildfolk hero"
    }
  ]
}
{% endschema %}
