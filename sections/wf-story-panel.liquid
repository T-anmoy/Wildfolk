{%- liquid
  assign panel_alt = section.settings.image.alt | default: section.settings.heading
-%}

<div class="wf-section wf-story-panel wf-story-panel--{{ section.settings.image_position }} color-{{ section.settings.color_scheme }} gradient">
  <div class="wf-grid">
    <div class="wf-story-panel__grid">
      <div class="wf-story-panel__media wf-frame">
        {%- render 'wf-media',
          image: section.settings.image,
          image_mobile: section.settings.image_mobile,
          alt: panel_alt,
          sizes_attr: '(min-width: 1200px) 530px, (min-width: 750px) 45vw, 100vw',
          sizes_mobile: '100vw'
        -%}
      </div>
      <div class="wf-story-panel__copy wf-measure">
        {%- if section.settings.eyebrow != blank -%}
          <p class="wf-eyebrow" data-wf-reveal>{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="wf-heading wf-heading--xl" data-wf-reveal>{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="wf-body rte" data-wf-reveal>{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.settings.stat_value != blank -%}
          <div class="wf-story-panel__stat" data-wf-reveal>
            <span class="wf-story-panel__stat-value">{{ section.settings.stat_value | escape }}</span>
            <span class="wf-story-panel__stat-label">{{ section.settings.stat_label | escape }}</span>
          </div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <div data-wf-reveal>
            <a
              {% if section.settings.button_link == blank %}role="link" aria-disabled="true"{% else %}href="{{ section.settings.button_link }}"{% endif %}
              class="button button--secondary"
            >
              {{ section.settings.button_label | escape }}
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Wildfolk story panel",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Portrait (4:5) works best. Set a focal point on the image to control the crop."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Optional separate crop for phones (below 750px). Falls back to the image above."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "options": [
        { "value": "image-first", "label": "Left" },
        { "value": "image-last", "label": "Right" }
      ],
      "default": "image-first"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why This Honey"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "[HEADING — client copy]"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Body text",
      "default": "<p>[PRODUCT DESCRIPTION — replace with confirmed client copy]</p>"
    },
    {
      "type": "text",
      "id": "stat_value",
      "label": "Optional statistic value",
      "info": "Only use a figure the client has confirmed."
    },
    {
      "type": "text",
      "id": "stat_label",
      "label": "Optional statistic label"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Why This Honey",
      "settings": { "eyebrow": "Why This Honey", "image_position": "image-first" }
    },
    {
      "name": "Quality",
      "settings": { "eyebrow": "Quality", "image_position": "image-last" }
    },
    {
      "name": "How To Use",
      "settings": { "eyebrow": "How To Use", "image_position": "image-first" }
    }
  ]
}
{% endschema %}
