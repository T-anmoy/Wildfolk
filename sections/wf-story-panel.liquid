{%- liquid
  assign layout = section.settings.layout | default: 'split'
  assign panel_alt = section.settings.image.alt | default: section.settings.heading
  # Outside the editor an empty image slot is not rendered: the panel becomes text-led.
  assign show_media = false
  if section.settings.image != blank or request.design_mode
    assign show_media = true
  endif
  case layout
    when 'full-bleed'
      assign sizes = '100vw'
    when 'inset'
      assign sizes = '(min-width: 1440px) 960px, (min-width: 900px) 66vw, 100vw'
    when 'statement'
      assign sizes = '(min-width: 1200px) 360px, (min-width: 750px) 33vw, 100vw'
    else
      assign sizes = '(min-width: 1200px) 530px, (min-width: 750px) 45vw, 100vw'
  endcase
-%}

{%- capture link_live -%}{%- render 'wf-link-live', url: section.settings.button_link -%}{%- endcapture -%}

{%- capture media -%}
  {%- if show_media -%}
    <div class="wf-story-panel__media wf-frame">
      {%- render 'wf-media',
        image: section.settings.image,
        image_mobile: section.settings.image_mobile,
        alt: panel_alt,
        sizes_attr: sizes,
        sizes_mobile: '100vw'
      -%}
    </div>
  {%- endif -%}
{%- endcapture -%}

{%- capture copy -%}
  <div class="wf-story-panel__copy">
    {%- if section.settings.eyebrow != blank -%}
      <p class="wf-eyebrow" data-wf-reveal>{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="wf-heading wf-story-panel__heading" data-wf-reveal>{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="wf-body rte wf-story-panel__text" data-wf-reveal>{% render 'wf-rte', html: section.settings.text %}</div>
    {%- endif -%}

    {%- if section.settings.stat_value != blank -%}
      <div class="wf-story-panel__stat" data-wf-reveal>
        <span class="wf-story-panel__stat-value">{{ section.settings.stat_value | escape }}</span>
        <span class="wf-story-panel__stat-label">{{ section.settings.stat_label | escape }}</span>
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank and link_live == 'true' -%}
      <div class="wf-story-panel__actions" data-wf-reveal>
        <a
          {% if section.settings.button_link == blank %}role="link" aria-disabled="true"{% else %}href="{{ section.settings.button_link }}"{% endif %}
          class="button button--secondary"
        >
          {{ section.settings.button_label | escape }}
        </a>
      </div>
    {%- endif -%}
  </div>
{%- endcapture -%}

<div
  class="wf-section wf-story-panel wf-story-panel--{{ layout }} wf-story-panel--{{ section.settings.image_position }}{% unless show_media %} wf-story-panel--no-media{% endunless %}{% if section.settings.image != blank %} wf-story-panel--has-image{% endif %} color-{{ section.settings.color_scheme }} gradient"
>
  <div class="wf-grid">
    <div class="wf-story-panel__grid">
      {%- comment -%} DOM order follows the phone order so reading and focus order match the screen. {%- endcomment -%}
      {%- if section.settings.mobile_order == 'text-first' -%}
        {{ copy }}{{ media }}
      {%- else -%}
        {{ media }}{{ copy }}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Wildfolk story panel",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "split", "label": "Split — image beside text" },
        { "value": "full-bleed", "label": "Full-bleed — text over the image" },
        { "value": "inset", "label": "Inset — large image, offset text panel" },
        { "value": "statement", "label": "Statement — large type, small image" }
      ],
      "default": "split",
      "info": "Without an image every layout becomes a text-led composition on the storefront."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Set a focal point on the image to control the crop."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Optional separate crop for phones (below 750px). Falls back to the image above."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "options": [
        { "value": "image-first", "label": "Left" },
        { "value": "image-last", "label": "Right" }
      ],
      "default": "image-first",
      "visible_if": "{{ section.settings.layout == 'split' or section.settings.layout == 'inset' or section.settings.layout == 'statement' }}"
    },
    {
      "type": "select",
      "id": "mobile_order",
      "label": "Order on phones",
      "options": [
        { "value": "image-first", "label": "Image first" },
        { "value": "text-first", "label": "Text first" }
      ],
      "default": "image-first",
      "visible_if": "{{ section.settings.layout != 'full-bleed' }}"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why This Honey"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "[HEADING — client copy]"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Body text",
      "default": "<p>[PRODUCT DESCRIPTION — replace with confirmed client copy]</p>"
    },
    {
      "type": "text",
      "id": "stat_value",
      "label": "Optional statistic value",
      "info": "Only use a figure the client has confirmed."
    },
    {
      "type": "text",
      "id": "stat_label",
      "label": "Optional statistic label"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Hidden on the storefront while the destination is empty or missing (e.g. a page not yet created)."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Why This Honey",
      "settings": { "eyebrow": "Why This Honey", "image_position": "image-first" }
    },
    {
      "name": "Quality",
      "settings": { "eyebrow": "Quality", "layout": "statement", "image_position": "image-last" }
    },
    {
      "name": "How To Use",
      "settings": { "eyebrow": "How To Use", "layout": "inset", "image_position": "image-first" }
    }
  ]
}
{% endschema %}
